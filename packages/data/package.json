{
  "name": "acp-agent-metadata",
  "version": "0.0.0",
  "description": "Type-safe ACP agent capability metadata (modes, commands, auth methods)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./gemini": {
      "types": "./dist/agents/gemini.d.ts",
      "import": "./dist/agents/gemini.js",
      "require": "./dist/agents/gemini.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build": "pnpm run codegen && tsup",
    "set-date-version": "tsx scripts/set-date-version.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
